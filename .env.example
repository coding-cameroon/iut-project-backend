# Configuration de la base de données
DATABASE_URL="postgresql://username:password@localhost:5432/securite_temps_reel?schema=public"

# Configuration JWT
JWT_SECRET="votre_secret_jwt_tres_securise_ici"
JWT_EXPIRES_IN="24h"

# Configuration du serveur
PORT=3000
NODE_ENV="development"

# Configuration CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Configuration Socket.IO
SOCKET_IO_CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Configuration de l'upload de fichiers
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

# Configuration email (optionnel)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="votre_email@gmail.com"
SMTP_PASS="votre_mot_de_passe_app"

# Configuration SMS (optionnel)
SMS_API_KEY="votre_cle_api_sms"
SMS_SENDER="VotreNom"

# Configuration géolocalisation
DEFAULT_LATITUDE=4.0511
DEFAULT_LONGITUDE=9.7679
DEFAULT_RADIUS=10000

# Configuration IA (pour intégration future)
AI_SERVICE_URL="http://localhost:5000"
AI_API_KEY="votre_cle_api_ia"

# Configuration de sécurité
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
