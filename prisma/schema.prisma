// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  firstName String
  lastName  String
  password  String
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  alerts             Alert[]
  sessions           Session[]
  emergencyServiceId String?
  emergencyService   EmergencyService? @relation(fields: [emergencyServiceId], references: [id])

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Alert {
  id          String      @id @default(cuid())
  title       String
  description String
  type        String // Dynamic type name
  alertTypeId String? // Relation to dynamic type
  alertType   AlertType?  @relation(fields: [alertTypeId], references: [id])
  priority    Priority    @default(MEDIUM)
  status      AlertStatus @default(PENDING)

  // Géolocalisation
  latitude  Float
  longitude Float
  address   String?
  city      String?
  country   String?

  // Métadonnées
  isAnonymous Boolean   @default(false)
  isVerified  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  // Relations
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       Media[]
  responses   AlertResponse[]
  assignments AlertAssignment[]

  @@map("alerts")
}

model Media {
  id           String @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  url          String

  // Métadonnées
  createdAt DateTime @default(now())

  // Relations
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@map("media")
}

model AlertResponse {
  id        String         @id @default(cuid())
  message   String
  status    ResponseStatus @default(SENT)
  createdAt DateTime       @default(now())

  // Relations
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@map("alert_responses")
}

model AlertAssignment {
  id         String           @id @default(cuid())
  assignedTo String
  status     AssignmentStatus @default(ASSIGNED)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Relations
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@map("alert_assignments")
}

model EmergencyService {
  id        String   @id @default(cuid())
  name      String
  type      String // Dynamic type (String)
  phone     String
  email     String?
  address   String
  latitude  Float
  longitude Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  alertTypes AlertType[]
  users      User[]

  @@map("emergency_services")
}

model AlertType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  severity    Priority @default(MEDIUM)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  services EmergencyService[]
  alerts   Alert[]

  @@map("alert_types")
}

model Statistics {
  id                  String   @id @default(cuid())
  date                DateTime @default(now())
  totalAlerts         Int
  resolvedAlerts      Int
  pendingAlerts       Int
  alertsByType        Json
  alertsByPriority    Json
  averageResponseTime Float?

  @@map("statistics")
}

// Enums
enum UserRole {
  USER
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum ResponseStatus {
  SENT
  DELIVERED
  FAILED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}
